{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetSense",
  "version": "1.0.1",
  "identifier": "com.netsense.app",
  "build": {
    "frontendDist": "../frontend",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bash ../frontend/serve.sh",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NetSense",
        "url": "editor.html",
        "width": 1180,
        "height": 700,
        "minWidth": 980,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false
      },
      {
        "label": "settings",
        "title": "NetSense",
        "url": "settings.html",
        "width": 620,
        "height": 600,
        "minWidth": 480,
        "minHeight": 420,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false
      },
      {
        "label": "logs",
        "title": "NetSense",
        "url": "logs.html",
        "width": 900,
        "height": 620,
        "minWidth": 620,
        "minHeight": 420,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false
      },
      {
        "label": "popup",
        "title": "NetSense",
        "url": "popup.html",
        "width": 360,
        "height": 620,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "fix-quarantine.sh"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
